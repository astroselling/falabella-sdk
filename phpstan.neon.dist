includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # Larastan asume la estructura de una aplicacion: aca config/ es el
        # config del propio paquete, donde llamar env() es lo idiomatico.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/*

